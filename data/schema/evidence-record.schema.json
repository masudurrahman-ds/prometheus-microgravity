{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROMETHEUS Evidence Record",
  "type": "object",
  "required": ["record_id", "evidence_state", "provenance"],
  "properties": {
    "record_id": {"type": "string"},
    "evidence_state": {
      "type": "string",
      "enum": ["NASA_OBSERVED", "NASA_REPORTED", "DERIVED", "MODEL_INFERRED", "ANALOGICAL", "UNKNOWN"]
    },
    "provenance": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "source_id": {"type": "string"},
        "investigation_id": {"type": "string"},
        "doi": {"type": ["string", "null"]},
        "source_url": {"type": "string"},
        "locator": {"type": ["string", "null"]},
        "source_version": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]}
      }
    }
  }
}
